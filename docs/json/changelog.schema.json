{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "odx changelog",
  "description": "What `odx --json changelog` prints.",
  "type": "object",
  "properties": {
    "errors": {
      "description": "Repositories or packages whose migrations could not be compared.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "migrations": {
      "description": "The migration scripts and version changes the changes bring in.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SniffedJson"
      }
    },
    "schema": {
      "description": "The version of this layout.",
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    },
    "sections": {
      "description": "Odoo, then repositories, then packages, each by name.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/SectionJson"
      }
    },
    "since": {
      "description": "The revision of `odx.lock` compared from.",
      "type": "string"
    },
    "to": {
      "description": "The revision compared to, or `working tree`.",
      "type": "string"
    }
  },
  "required": [
    "schema",
    "since",
    "to",
    "sections",
    "migrations",
    "errors"
  ],
  "$defs": {
    "AddonChangeJson": {
      "description": "What a change does to one addon's database migration.",
      "type": "object",
      "properties": {
        "addon": {
          "description": "The addon.",
          "type": "string"
        },
        "bumped_without_scripts": {
          "description": "The version changed without migration scripts.",
          "type": "boolean"
        },
        "previous_version": {
          "description": "The manifest version before the change, if known.",
          "type": [
            "string",
            "null"
          ]
        },
        "scripts": {
          "description": "Migration scripts added or modified, sorted by path.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Script"
          }
        },
        "version": {
          "description": "The manifest version after the change, if known.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "addon",
        "bumped_without_scripts",
        "scripts"
      ]
    },
    "Change": {
      "description": "How a file changed.",
      "oneOf": [
        {
          "description": "The file is new.",
          "type": "string",
          "const": "added"
        },
        {
          "description": "The file existed and changed.",
          "type": "string",
          "const": "modified"
        }
      ]
    },
    "ItemJson": {
      "description": "One change in a section.",
      "oneOf": [
        {
          "description": "A merge or package that is new.",
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "added"
            },
            "source": {
              "description": "Where it comes from; null for a package.",
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceJson"
                },
                {
                  "type": "null"
                }
              ]
            },
            "to": {
              "description": "The commit it is at.",
              "type": "string"
            }
          },
          "required": [
            "change",
            "to"
          ]
        },
        {
          "description": "A merge or package that is gone.",
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "removed"
            },
            "source": {
              "description": "Where it came from; null for a package.",
              "anyOf": [
                {
                  "$ref": "#/$defs/SourceJson"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "change"
          ]
        },
        {
          "description": "A commit that moved.",
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "updated"
            }
          },
          "$ref": "#/$defs/MovedJson",
          "required": [
            "change"
          ]
        },
        {
          "description": "A base that moved.",
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "base"
            }
          },
          "$ref": "#/$defs/MovedJson",
          "required": [
            "change"
          ]
        },
        {
          "description": "A URL that changed.",
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "url"
            }
          },
          "$ref": "#/$defs/MovedJson",
          "required": [
            "change"
          ]
        },
        {
          "description": "A merge whose lock-time status changed.",
          "type": "object",
          "properties": {
            "change": {
              "type": "string",
              "const": "status"
            },
            "from": {
              "description": "The status before: `merged`, `skipped` or `pinned`.",
              "type": "string"
            },
            "since": {
              "description": "Since when it is pinned.",
              "type": [
                "string",
                "null"
              ]
            },
            "source": {
              "description": "Where it comes from.",
              "$ref": "#/$defs/SourceJson"
            },
            "to": {
              "description": "The status now.",
              "type": "string"
            }
          },
          "required": [
            "change",
            "source",
            "from",
            "to"
          ]
        }
      ]
    },
    "MovedJson": {
      "description": "A commit, base or URL that moved.",
      "type": "object",
      "properties": {
        "commits": {
          "description": "Commits between the two, when known.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint",
          "minimum": 0
        },
        "from": {
          "description": "Before.",
          "type": "string"
        },
        "source": {
          "description": "The merge it belongs to; null for the repository or package itself.",
          "anyOf": [
            {
              "$ref": "#/$defs/SourceJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "to": {
          "description": "After.",
          "type": "string"
        }
      },
      "required": [
        "from",
        "to"
      ]
    },
    "Phase": {
      "description": "When Odoo runs a migration script.",
      "oneOf": [
        {
          "description": "Before the addon's models are loaded.",
          "type": "string",
          "const": "pre"
        },
        {
          "description": "After the addon is updated.",
          "type": "string",
          "const": "post"
        },
        {
          "description": "After every addon is updated.",
          "type": "string",
          "const": "end"
        }
      ]
    },
    "Script": {
      "description": "A migration script that a change adds or modifies.",
      "type": "object",
      "properties": {
        "addon": {
          "description": "The addon the script migrates.",
          "type": "string"
        },
        "change": {
          "description": "Added or modified.",
          "$ref": "#/$defs/Change"
        },
        "path": {
          "description": "Path of the script in its repository.",
          "type": "string"
        },
        "phase": {
          "description": "When the script runs.",
          "$ref": "#/$defs/Phase"
        },
        "version": {
          "description": "The version directory: the script runs when the addon moves past it.",
          "type": "string"
        }
      },
      "required": [
        "addon",
        "version",
        "phase",
        "path",
        "change"
      ]
    },
    "SectionJson": {
      "description": "Odoo, a repository or a package, and what changed in it.",
      "type": "object",
      "properties": {
        "items": {
          "description": "What changed.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/ItemJson"
          }
        },
        "kind": {
          "description": "`odoo`, `repository` or `package`.",
          "type": "string"
        },
        "name": {
          "description": "The repository name or distribution; `odoo` for Odoo.",
          "type": "string"
        },
        "state": {
          "description": "`added`, `removed` or `changed`.",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "name",
        "state",
        "items"
      ]
    },
    "SniffedJson": {
      "description": "What one repository or package change does to database migrations.",
      "type": "object",
      "properties": {
        "addons": {
          "description": "Addons with migration scripts or a version change.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/AddonChangeJson"
          }
        },
        "kind": {
          "description": "`repository` or `package`.",
          "type": "string"
        },
        "name": {
          "description": "Repository name or distribution.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "kind",
        "addons"
      ]
    },
    "SourceJson": {
      "description": "Where a merge or package comes from, as configured.",
      "type": "object",
      "properties": {
        "branch": {
          "description": "The configured branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "link": {
          "description": "The pull request's page on the forge.",
          "type": [
            "string",
            "null"
          ]
        },
        "pr": {
          "description": "The pull request number.",
          "type": [
            "integer",
            "null"
          ],
          "format": "uint32",
          "minimum": 0
        },
        "remote": {
          "description": "The remote of the branch.",
          "type": [
            "string",
            "null"
          ]
        },
        "sha": {
          "description": "The configured commit.",
          "type": [
            "string",
            "null"
          ]
        },
        "tag": {
          "description": "The configured tag.",
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
