{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "odx migrate pin",
  "description": "What `odx --json migrate pin` prints.",
  "type": "object",
  "properties": {
    "pinned": {
      "description": "The requirement lines pinned to pull requests.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "schema": {
      "description": "The version of this layout.",
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    },
    "waits_on": {
      "description": "Dependencies not on the target series yet.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Waiting"
      }
    }
  },
  "required": [
    "schema",
    "pinned",
    "waits_on"
  ],
  "$defs": {
    "Migration": {
      "description": "An open migration pull request of a dependency.",
      "type": "object",
      "properties": {
        "head": {
          "description": "The ref a pip requirement points at for it.",
          "type": "string"
        },
        "number": {
          "description": "Its number.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "origin": {
          "description": "Where the repository is served: `scheme://host[:port]`.",
          "type": "string"
        },
        "repository": {
          "description": "`owner/repo` of its repository.",
          "type": "string"
        },
        "url": {
          "description": "Its page.",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "origin",
        "number",
        "url",
        "head"
      ]
    },
    "Waiting": {
      "description": "A dependency that is not available on the target series yet.",
      "type": "object",
      "properties": {
        "addon": {
          "description": "The dependency.",
          "type": "string"
        },
        "pull_request": {
          "description": "Its open migration pull request, when there is one.",
          "anyOf": [
            {
              "$ref": "#/$defs/Migration"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "description": "The repository it lives in on the source series, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "addon"
      ]
    }
  }
}
