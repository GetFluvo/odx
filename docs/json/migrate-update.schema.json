{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "odx migrate update",
  "description": "What `odx --json migrate update` prints.",
  "type": "object",
  "properties": {
    "branch": {
      "description": "The migration branch.",
      "type": "string"
    },
    "commits": {
      "description": "The subjects of the commits the fixes made.",
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "findings": {
      "description": "What odoo-lint leaves to fix by hand.",
      "type": "array",
      "items": {
        "$ref": "#/$defs/Finding"
      }
    },
    "history": {
      "description": "The commits of history replayed from the source series, after the\nsquash.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "pushed_to": {
      "description": "Where `--push` sent the branch: `<remote> <branch>`.",
      "type": [
        "string",
        "null"
      ]
    },
    "schema": {
      "description": "The version of this layout.",
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    },
    "source": {
      "description": "Where the history came from: `<remote>/<from>`.",
      "type": "string"
    },
    "squashed": {
      "description": "The administrative commits squashed into others.",
      "type": "integer",
      "format": "uint",
      "minimum": 0
    },
    "status": {
      "description": "Always `updated`.",
      "type": "string",
      "const": "updated"
    },
    "timings": {
      "description": "How long each phase took, in milliseconds: history, squash,\npre-commit, odoo-lint.",
      "type": "array",
      "items": {
        "type": "array",
        "maxItems": 2,
        "minItems": 2,
        "prefixItems": [
          {
            "type": "string"
          },
          {
            "type": "integer",
            "format": "uint64",
            "minimum": 0
          }
        ]
      }
    },
    "update": {
      "description": "An update of an existing migration (`odx migrate update`).",
      "type": "boolean"
    },
    "warnings": {
      "description": "Steps that could not run, and why.",
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "required": [
    "schema",
    "status",
    "branch",
    "source",
    "history",
    "squashed",
    "commits",
    "findings",
    "warnings",
    "timings",
    "update"
  ],
  "$defs": {
    "Finding": {
      "description": "A finding odoo-lint leaves to fix by hand.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The rule's code, e.g. `U1908`.",
          "type": "string"
        },
        "file_path": {
          "description": "The file, relative to the repository.",
          "type": "string"
        },
        "line": {
          "description": "The line.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "message": {
          "description": "What to do.",
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "line",
        "code",
        "message"
      ]
    }
  }
}
