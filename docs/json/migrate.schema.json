{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "odx migrate",
  "description": "What `odx --json migrate addon`, `--continue` and `--abort` print.",
  "type": "object",
  "properties": {
    "schema": {
      "description": "The version of this layout.",
      "type": "integer",
      "format": "uint32",
      "const": 1,
      "minimum": 0
    }
  },
  "oneOf": [
    {
      "description": "The migration branch is ready for review.",
      "type": "object",
      "properties": {
        "branch": {
          "description": "The migration branch.",
          "type": "string"
        },
        "commits": {
          "description": "The subjects of the commits the fixes made.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "findings": {
          "description": "What odoo-lint leaves to fix by hand.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Finding"
          }
        },
        "history": {
          "description": "The commits of history replayed from the source series, after the\nsquash.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "pinned": {
          "description": "The requirement lines pinned to pull requests, with\n`--pin-unreleased`.",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "pull_request": {
          "description": "The pull request opened, with `--open-pr`.",
          "anyOf": [
            {
              "$ref": "#/$defs/OpenedJson"
            },
            {
              "type": "null"
            }
          ]
        },
        "source": {
          "description": "Where the history came from: `<remote>/<from>`.",
          "type": "string"
        },
        "squashed": {
          "description": "The administrative commits squashed into others.",
          "type": "integer",
          "format": "uint",
          "minimum": 0
        },
        "status": {
          "type": "string",
          "const": "done"
        },
        "timings": {
          "description": "How long each phase took, in milliseconds: history, squash,\npre-commit, odoo-lint.",
          "type": "array",
          "items": {
            "type": "array",
            "maxItems": 2,
            "minItems": 2,
            "prefixItems": [
              {
                "type": "string"
              },
              {
                "type": "integer",
                "format": "uint64",
                "minimum": 0
              }
            ]
          }
        },
        "update": {
          "description": "An update of an existing migration (`odx migrate update`).",
          "type": "boolean"
        },
        "waits_on": {
          "description": "Dependencies not on the target series yet.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/Waiting"
          }
        },
        "warnings": {
          "description": "Steps that could not run, and why.",
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "status",
        "branch",
        "source",
        "history",
        "squashed",
        "commits",
        "findings",
        "warnings",
        "timings",
        "update",
        "waits_on",
        "pinned"
      ]
    },
    {
      "description": "A conflict stopped the migration.",
      "type": "object",
      "properties": {
        "message": {
          "description": "What happened and how to go on.",
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "stopped"
        }
      },
      "required": [
        "status",
        "message"
      ]
    },
    {
      "description": "`--abort` put the repository back.",
      "type": "object",
      "properties": {
        "branch": {
          "description": "The migration branch.",
          "type": "string"
        },
        "status": {
          "type": "string",
          "const": "aborted"
        }
      },
      "required": [
        "status",
        "branch"
      ]
    }
  ],
  "required": [
    "schema"
  ],
  "$defs": {
    "Finding": {
      "description": "A finding odoo-lint leaves to fix by hand.",
      "type": "object",
      "properties": {
        "code": {
          "description": "The rule's code, e.g. `U1908`.",
          "type": "string"
        },
        "file_path": {
          "description": "The file, relative to the repository.",
          "type": "string"
        },
        "line": {
          "description": "The line.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "message": {
          "description": "What to do.",
          "type": "string"
        }
      },
      "required": [
        "file_path",
        "line",
        "code",
        "message"
      ]
    },
    "Migration": {
      "description": "An open migration pull request of a dependency.",
      "type": "object",
      "properties": {
        "head": {
          "description": "The ref a pip requirement points at for it.",
          "type": "string"
        },
        "number": {
          "description": "Its number.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "origin": {
          "description": "Where the repository is served: `scheme://host[:port]`.",
          "type": "string"
        },
        "repository": {
          "description": "`owner/repo` of its repository.",
          "type": "string"
        },
        "url": {
          "description": "Its page.",
          "type": "string"
        }
      },
      "required": [
        "repository",
        "origin",
        "number",
        "url",
        "head"
      ]
    },
    "OpenedJson": {
      "description": "A pushed branch and the pull request opened for it.",
      "type": "object",
      "properties": {
        "draft": {
          "description": "Whether it was opened as a draft.",
          "type": "boolean"
        },
        "number": {
          "description": "The pull request number.",
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "pushed_to": {
          "description": "Where the branch went: a remote or a URL.",
          "type": "string"
        },
        "status": {
          "description": "Always `opened`.",
          "type": "string",
          "const": "opened"
        },
        "url": {
          "description": "The pull request page.",
          "type": "string"
        }
      },
      "required": [
        "status",
        "pushed_to",
        "number",
        "url",
        "draft"
      ]
    },
    "Waiting": {
      "description": "A dependency that is not available on the target series yet.",
      "type": "object",
      "properties": {
        "addon": {
          "description": "The dependency.",
          "type": "string"
        },
        "pull_request": {
          "description": "Its open migration pull request, when there is one.",
          "anyOf": [
            {
              "$ref": "#/$defs/Migration"
            },
            {
              "type": "null"
            }
          ]
        },
        "repository": {
          "description": "The repository it lives in on the source series, when known.",
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "addon"
      ]
    }
  }
}
